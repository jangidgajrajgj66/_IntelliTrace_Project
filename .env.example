# Environment Configuration for IntelliTrace (Author: Gajraj Jangid)
# Copy this file to .env to customize settings

# Host & Port Settings
API_HOST=127.0.0.1
API_PORT=8000
REAL_APP_PORT=8080

# LLM Provider Configuration
# Options: "auto" (default - uses Gemini/OpenAI if available, else zero-cost heuristic engine)
#          "gemini", "openai", "ollama", "heuristic"
LLM_PROVIDER=auto

# Optional API Keys (Leave blank to use built-in offline heuristic reasoning engine)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Ollama local model configuration (if using local LLMs)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=gemini-1.5-flash
